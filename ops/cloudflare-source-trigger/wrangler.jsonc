{
  "name": "xray-519-source-qa",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "triggers": {
    "crons": ["1 * * * *", "6 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "SOURCE_DISPATCH_LOCK", "class_name": "SourceDispatchLock" }
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "exports": {
    "SourceDispatchLock": { "type": "durable-object", "storage": "sqlite" }
  }
}
